#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/contract-negotiations-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git jq openssh-client e2fsprogs
# Keep administration available even if a later bootstrap step fails.
if ! snap list amazon-ssm-agent >/dev/null 2>&1; then snap install amazon-ssm-agent --classic; fi
snap start amazon-ssm-agent
# The attachment is created after EC2. Match EBS ID, never guess the root disk.
volume_serial=$(echo '${volume_id}' | tr -d '-')
device=''
for attempt in $(seq 1 120); do
  device=$(lsblk -ndo PATH,SERIAL | awk -v serial="$volume_serial" '$2 == serial {print $1; exit}')
  if [ -n "$device" ]; then break; fi
  # Non-NVMe instance types expose the requested attachment under /dev/xvdf.
  if [ -b /dev/xvdf ]; then device=/dev/xvdf; break; fi
  sleep 5
done
if [ -z "$device" ]; then echo 'Data volume did not attach'; exit 1; fi
if ! blkid "$device" >/dev/null 2>&1; then
  # Only format a completely blank disk. Do not overwrite an unexpected layout.
  if [ -n "$(wipefs -n "$device")" ] || [ "$(lsblk -nr "$device" | wc -l)" -ne 1 ]; then
    echo 'Unrecognized data disk layout; refusing to format'; exit 1
  fi
  mkfs.ext4 "$device"
fi
if [ "$(blkid -s TYPE -o value "$device")" != ext4 ]; then echo 'Expected ext4 data volume'; exit 1; fi
mkdir -p /srv/contract-negotiations
uuid=$(blkid -s UUID -o value "$device")
if ! grep -q "UUID=$uuid " /etc/fstab; then
  echo "UUID=$uuid /srv/contract-negotiations ext4 defaults 0 2" >> /etc/fstab
fi
mountpoint -q /srv/contract-negotiations || mount /srv/contract-negotiations
# Ensure Docker cannot run against an unmounted, empty directory after a reboot.
mkdir -p /etc/systemd/system/docker.service.d
printf '[Unit]\nRequiresMountsFor=/srv/contract-negotiations\n' > /etc/systemd/system/docker.service.d/data.conf
systemctl daemon-reload
# Infrastructure setup only: application source is fetched by an explicit deployment.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL --retry 5 https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
source /etc/os-release
arch=$(dpkg --print-architecture)
echo "deb [arch=$arch signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
install -d -m 0700 -o 1000 -g 1000 /srv/contract-negotiations/data
install -d -m 0700 /srv/contract-negotiations/git /srv/contract-negotiations/releases /srv/contract-negotiations/backups
install -d -m 0700 /srv/contract-negotiations/caddy-data /srv/contract-negotiations/caddy-config
if [ ! -f /srv/contract-negotiations/git/id_ed25519 ]; then
  ssh-keygen -q -t ed25519 -N '' -C '${repository} EC2 read-only deployment' -f /srv/contract-negotiations/git/id_ed25519
fi
# GitHub publishes SSH host keys over authenticated HTTPS; do not trust ssh-keyscan alone.
curl -fsSL --retry 5 https://api.github.com/meta | jq -er '.ssh_keys[] | "[ssh.github.com]:443 " + .' > /srv/contract-negotiations/git/known_hosts
chmod 600 /srv/contract-negotiations/git/known_hosts
cat > /etc/contract-negotiations.env <<'CONFIG'
DOMAIN='${domain}'
GITHUB_REPOSITORY='${repository}'
CONFIG
chmod 600 /etc/contract-negotiations.env
echo '${deploy_script}' | base64 --decode > /usr/local/sbin/deploy-contract-negotiations
chmod 700 /usr/local/sbin/deploy-contract-negotiations
# Rebuild the last successful release on a replacement instance. First launch waits for deployment.
if [ -f /srv/contract-negotiations/active-release ]; then
  /usr/local/sbin/deploy-contract-negotiations --restore
fi
touch /var/lib/contract-negotiations-ready
echo 'Infrastructure ready. Add the public deploy key to GitHub, then deploy a commit.'
