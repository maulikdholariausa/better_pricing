DOMAIN=quotes.example.com
DATA_PATH=/srv/contract-negotiations/data
SEO_INDEXABLE=false
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=GTM-5V25KW4H
# Copy to .env for common settings, or .env.dev / .env.staging / .env.prod.
# Local SITE_URL and port default to the selected environment.

# Production values are supplied by Terraform through encrypted SSM runtime config.
AWS_REGION=us-east-2
# Each environment selects its own bucket automatically.
# Override only in .env.dev / .env.staging / .env.prod if needed.
# QUOTES_BUCKET=haveaguru-quotes-dev
NOTIFY_CONFIGURATION_ID=
NOTIFY_CODE_CONFIGURATION_ID=
SMS_MONTHLY_SEND_LIMIT=400
ORIGIN_HOST=origin.quotes.example.com
ORIGIN_SECRET=
REQUIRE_CLOUDFRONT=false
# Dev defaults to test code 123456. Set GURU_DEV_OTP=0 for real SMS in dev.
# Staging and prod always use real SMS.
# AWS_PROFILE=better-pricing # Required for local prod if not set in your shell.
